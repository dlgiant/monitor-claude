# Source this in any shell BEFORE starting `claude` to point its
# telemetry at the local OTel collector:
#   source ~/monitor-claude/claude-otel.env && claude
export CLAUDE_CODE_ENABLE_TELEMETRY=1
export OTEL_METRICS_EXPORTER=otlp
export OTEL_LOGS_EXPORTER=otlp
export OTEL_TRACES_EXPORTER=otlp
export OTEL_EXPORTER_OTLP_PROTOCOL=grpc
export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Claude Code defaults to delta sums; we send cumulative so Prometheus'
# OTLP receiver accepts them (it rejects delta with "invalid temporality").
export OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative

# Tune thresholds via env vars (default warn=20, deny=40):
#   export CC_STUCK_WARN=15
#   export CC_STUCK_DENY=30
