{
  "title": "Claude Code — Cost & Performance",
  "uid": "claude-code-cost",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": ["claude-code", "otel"],
  "time": { "from": "now-7d", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prom" },
        "query": "label_values(claude_code_token_usage_tokens_total, model)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      },
      {
        "name": "input_price",
        "label": "$/MTok input (cache-savings calc)",
        "type": "constant",
        "current": { "text": "15", "value": "15" },
        "query": "15"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total cost (window)",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 2 }
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_cost_usage_USD_total{model=~`${model:regex}`}[$__range]))",
          "legendFormat": "USD"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "cacheRead / (cacheRead + input). Higher = lower spend.",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.4 },
              { "color": "green", "value": 0.7 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_token_usage_tokens_total{type=\"cacheRead\",model=~`${model:regex}`}[$__range])) / clamp_min(sum(increase(claude_code_token_usage_tokens_total{type=~\"cacheRead|input\",model=~`${model:regex}`}[$__range])), 1)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cost per accepted edit",
      "description": "USD spent per accepted Edit/Write/MultiEdit. The closest thing to ROI.",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 3 }
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_cost_usage_USD_total{model=~`${model:regex}`}[$__range])) / clamp_min(sum(increase(claude_code_code_edit_tool_decision_total{decision=\"accept\"}[$__range])), 1)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Sessions (window)",
      "description": "Counts session starts. Resumed sessions don't increment.",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "expr": "sum(increase(claude_code_session_count_total[$__range]))" }
      ]
    },

    {
      "id": 9,
      "type": "stat",
      "title": "Cost per session",
      "description": "Total spend / session starts in window. ROI per task.",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 } },
      "targets": [
        {
          "expr": "sum(increase(claude_code_cost_usage_USD_total{model=~`${model:regex}`}[$__range])) / clamp_min(sum(increase(claude_code_session_count_total[$__range])), 1)"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Cache savings $ (approx)",
      "description": "Estimated USD avoided by cache reads vs paying full input price. Tune $/MTok dashboard variable to your model. Net = 0.9·cacheRead − 1.25·cacheCreation, scaled by input price.",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      },
      "targets": [
        {
          "expr": "(sum(increase(claude_code_token_usage_tokens_total{type=\"cacheRead\",model=~`${model:regex}`}[$__range])) * 0.9 - sum(increase(claude_code_token_usage_tokens_total{type=\"cacheCreation\",model=~`${model:regex}`}[$__range])) * 1.25) * ${input_price} / 1e6"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Edit accept rate",
      "description": "% of code-edit suggestions accepted. Trust regression detector.",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_code_edit_tool_decision_total{decision=\"accept\"}[$__range])) / clamp_min(sum(increase(claude_code_code_edit_tool_decision_total[$__range])), 1)"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Active time",
      "description": "Total wall-clock time Claude was actively running (CLI).",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "sum(increase(claude_code_active_time_seconds_total[$__range]))" }
      ]
    },

    {
      "id": 5,
      "type": "timeseries",
      "title": "Cost rate by model ($/hour)",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 }
        }
      },
      "options": { "legend": { "displayMode": "table", "calcs": ["sum", "mean"] } },
      "targets": [
        {
          "expr": "sum by (model) (rate(claude_code_cost_usage_USD_total{model=~`${model:regex}`}[5m])) * 3600",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Cost rate by effort tier ($/hour)",
      "description": "How much you spend at each thinking-effort level. xhigh is usually the biggest knob.",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 40,
            "lineWidth": 2,
            "stacking": { "mode": "normal" }
          }
        }
      },
      "options": { "legend": { "displayMode": "table", "calcs": ["sum"] } },
      "targets": [
        {
          "expr": "sum by (effort) (rate(claude_code_cost_usage_USD_total{model=~`${model:regex}`}[5m])) * 3600",
          "legendFormat": "{{effort}}"
        }
      ]
    },

    {
      "id": 6,
      "type": "timeseries",
      "title": "Tokens by type",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 40,
            "stacking": { "mode": "normal" }
          }
        }
      },
      "options": { "legend": { "displayMode": "table", "calcs": ["sum"] } },
      "targets": [
        {
          "expr": "sum by (type) (rate(claude_code_token_usage_tokens_total{model=~`${model:regex}`}[5m]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "API request latency p50/p95/p99 (ms) by model",
      "description": "Latency quantiles from claude_code.api_request log events. Catches model-routing slow days.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5 }
        }
      },
      "options": { "legend": { "displayMode": "table", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "expr": "quantile_over_time(0.50, {service_name=\"claude-code\"} | event_name = `api_request` | unwrap duration_ms [5m]) by (model)",
          "legendFormat": "p50 {{model}}"
        },
        {
          "expr": "quantile_over_time(0.95, {service_name=\"claude-code\"} | event_name = `api_request` | unwrap duration_ms [5m]) by (model)",
          "legendFormat": "p95 {{model}}"
        },
        {
          "expr": "quantile_over_time(0.99, {service_name=\"claude-code\"} | event_name = `api_request` | unwrap duration_ms [5m]) by (model)",
          "legendFormat": "p99 {{model}}"
        }
      ]
    },

    {
      "id": 7,
      "type": "timeseries",
      "title": "Edit-tool decisions (accept vs reject)",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 80 }
        }
      },
      "targets": [
        {
          "expr": "sum by (decision) (rate(claude_code_code_edit_tool_decision_total[5m]))",
          "legendFormat": "{{decision}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Tool result size p95 (bytes) by tool",
      "description": "How much context each tool consumes back. Find the tools eating your budget.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5 }
        }
      },
      "options": { "legend": { "displayMode": "table", "calcs": ["max"] } },
      "targets": [
        {
          "expr": "quantile_over_time(0.95, {service_name=\"claude-code\"} | event_name = `tool_result` | unwrap tool_result_size_bytes [5m]) by (tool_name)",
          "legendFormat": "{{tool_name}}"
        }
      ]
    },

    {
      "id": 16,
      "type": "heatmap",
      "title": "Activity heatmap (active seconds / 5m bucket)",
      "description": "Density of CLI active time over your week. Tall stripes = focus blocks; gaps = downtime.",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "options": {
        "calculate": true,
        "calculation": { "yBuckets": { "mode": "size", "value": "60" } },
        "color": { "mode": "scheme", "scheme": "Turbo", "steps": 64 },
        "yAxis": { "unit": "s" }
      },
      "targets": [
        { "expr": "sum(rate(claude_code_active_time_seconds_total[5m])) * 300" }
      ]
    },
    {
      "id": 17,
      "type": "barchart",
      "title": "Edits accepted by language (window)",
      "description": "Where Claude is actually working in your repos.",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 80 }
        }
      },
      "options": {
        "orientation": "horizontal",
        "legend": { "showLegend": false },
        "xField": "language"
      },
      "targets": [
        {
          "expr": "sort_desc(sum by (language) (increase(claude_code_code_edit_tool_decision_total{decision=\"accept\"}[$__range])))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{language}}"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true }
          }
        }
      ]
    },

    {
      "id": 18,
      "type": "piechart",
      "title": "Auxiliary vs main spend",
      "description": "Auxiliary = subagents and background tasks; main = your direct prompts. Big auxiliary share = subagent-heavy workflow.",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "options": {
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "legend": { "displayMode": "table", "values": ["value", "percent"] }
      },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "targets": [
        {
          "expr": "sum by (query_source) (increase(claude_code_cost_usage_USD_total{model=~`${model:regex}`}[$__range]))",
          "legendFormat": "{{query_source}}"
        }
      ]
    },
    {
      "id": 19,
      "type": "table",
      "title": "Auxiliary cost (subagent proxy)",
      "description": "Top auxiliary spend by model + effort. True per-subagent attribution requires Tempo traces — open Explore → Tempo and run TraceQL once Claude Code emits spans.",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "options": { "showHeader": true },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 3 }
      },
      "targets": [
        {
          "expr": "sort_desc(sum by (model, effort) (increase(claude_code_cost_usage_USD_total{query_source=\"auxiliary\",model=~`${model:regex}`}[$__range])))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true }
          }
        }
      ]
    },

    {
      "id": 20,
      "type": "timeseries",
      "title": "Cognitive throughput (output tokens / sec) by effort tier",
      "description": "Output tokens generated per second of API request time, grouped by thinking-effort tier. Drops when the agent is wrestling a hard problem; rises in flow. The drop-with-effort-rise pattern is the closest telemetry signature of 'the brain working harder'.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": { "legend": { "displayMode": "table", "calcs": ["mean", "max", "min"] } },
      "targets": [
        {
          "expr": "1000 * (sum by (effort) (sum_over_time({service_name=\"claude-code\"} | event_name = `api_request` | unwrap output_tokens [5m])) / sum by (effort) (sum_over_time({service_name=\"claude-code\"} | event_name = `api_request` | unwrap duration_ms [5m])))",
          "legendFormat": "{{effort}}"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Tool-decision Shannon entropy (bits)",
      "description": "Diversity of tool usage in a 5m window. 0 = stuck on one tool (loop / dead end). log2(N) = uniform across N distinct tools (broad exploration). Sudden collapses are the signature of a thought-loop.",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "thresholdsStyle": { "mode": "line+area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 1.5 }
            ]
          }
        }
      },
      "options": { "legend": { "displayMode": "list" } },
      "targets": [
        {
          "expr": "- sum( (rate(claude_tool_decision_count_total[5m]) / on() group_left() sum(rate(claude_tool_decision_count_total[5m]))) * ln(rate(claude_tool_decision_count_total[5m]) / on() group_left() sum(rate(claude_tool_decision_count_total[5m]))) ) / 0.6931471805599453",
          "legendFormat": "H (bits)"
        },
        {
          "expr": "count(rate(claude_tool_decision_count_total[5m]) > 0)",
          "legendFormat": "active tools"
        }
      ]
    },

    {
      "id": 8,
      "type": "table",
      "title": "Cost breakdown (window)",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 56 },
      "options": { "showHeader": true },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 3 } },
      "targets": [
        {
          "expr": "sort_desc(sum by (model, effort, query_source) (increase(claude_code_cost_usage_USD_total[$__range])))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true }
          }
        }
      ]
    }
  ]
}
